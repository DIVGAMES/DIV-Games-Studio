# libretro core. SDL 1.2 is the shim under src/libretro/sdl; libSDL is not linked.

MESSAGE(STATUS "BUILDING DIV LIBRETRO CORE")

SET(PLATFORM "LIBRETRO")
SET(LIBRETRO 1)

SET(HAS_SDL 1)
SET(HAS_RAYLIB 0)
SET(HAS_SDLTTF 0)
SET(HAS_SDLIMAGE 0)
SET(HAS_ZLIB 1)
SET(HAS_SDLMIXER 0)
SET(HAS_DLL 0)
SET(HAS_NET 0)
SET(HAS_JPEG 0)
SET(HAS_FLI 1)
SET(HAS_MODE8 1)
SET(HAS_GIT 0)

ADD_DEFINITIONS(-DLIBRETRO -DMIXER)

INCLUDE_DIRECTORIES(${CMAKE_CURRENT_LIST_DIR}/../src/libretro/sdl)
INCLUDE_DIRECTORIES(${CMAKE_CURRENT_LIST_DIR}/../src/libretro)
