
;컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴
;       Token definitions
;컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴
;       If two or more symbols are declared with the same identifier, only the
;       first one will be recognized (whether tokens or table objects)
;       Limitation, do not mix symbols with identifier characters in a
;       single token (the ident. characters are the ones in lower[]).
;       Token codes &01..&77 (hex) are free to be redefined
;컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴

&01program              ;Program
&02const                ;Const
&03global               ;Global
&04local                ;Local
&05begin                ;Begin
&06end                  ;End
&07process              ;Process
&08private              ;Private
&09struct               ;Struct
&0Aimport               ;Import
&75include				;Include (additional prg)

&0Bsetup_program        ;Setup_program

&0Cstring               ;String
&0Dbyte                 ;Byte
&0Eword                 ;Word
&0Fint                  ;Int

&10compiler_options     ;Compiler_options
&11function             ;Function

&16until                ;Until
&17else                 ;Else

&18return               ;Return

&19from                 ;From
&1Ato                   ;To
&1Bstep                 ;Step

&20if                   ;If

&21loop                 ;Loop
&22while                ;While
&23repeat               ;Repeat
&24for                  ;For

&25switch               ;Switch
&26case                 ;Case
&27default              ;Default

&28frame                ;Frame

&29break                ;Break
&2Acontinue             ;Continue

&2Bclone                ;Clone

&2Cdebug                ;Debug

&30; &30:               ;Statement separator
&31,                    ;Expression separator

&32[                    ;Indirection, start
&33]                    ;Indirection, end

&38= &38:=              ;Assignment

&3Cdup                  ;Dup

&40(                    ;Parenthesis, opening
&41)                    ;Parenthesis, closing

;&44add                 ;Exclusively binary addition, becomes + in tab_exp
;&45sub                 ;Exclusively binary subtraction, becomes -

&46>>                   ;Rotate right
&47<<                   ;Rotate left

&48or &48|| &48|        ;Logical or
&49xor &49^^            ;Logical xor
&4Aand &4A&&            ;Logical and

&4B^                    ;Pointer (unary) or else logical xor (binary)
&4C&                    ;Offset (unary) or else logical and (binary)

&4Eneg                  ;Unary minus sign
&4Fpointer              ;Indirection operator, unary

&50offset               ;Unary shift
&51! &51not             ;Unary logical negation
                                                                               �
&52+                    ;Binary addition, used as unary it is ignored
&53-                    ;Binary subtraction, used as unary it is equivalent to neg

&54*                    ;Multiplication, used as unary it is equivalent to pointer
&55/ ;&55div            ;Integer division, quotient
&56% &56mod             ;Modulo, remainder of integer division
;&57mul                 ;Exclusively binary multiplication, becomes *

&58++                   ;Increment
&59--                   ;Decrement

&5B== &5B_eq            ;Equal, binary comparison operator
&5C<> &5C!= &5C_ne      ;Different

&5D> &5D_gt             ;Greater than
&5E< &5E_lt             ;Less than
&5F<= &5F=< &5F_le      ;Less than or equal
&60>= &60=> &60_ge      ;Greater than or equal

&66sizeof               ;Internal sizeof() function, returns length

&67type                 ;Operand that means the code of the executed process

&68id &68whoami         ;Operand that means the code of the executed process

&69. &69->              ;Operator to access other processes' variables (e.g.: ship.x)

&6A..                   ;Range specifier (inside a case)

&6B+=                   ;Operative assignments (C abbreviations)
&6C-=
&6D*=
&6E/=
&6F%=
&70&=
&71|=
&72^=
&73>>=
&74<<=

;컴� Special or reserved token codes 컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴컴

&00                  ;&00 p_last (End of file)
&78' &79"               ;&78..&7B literal delimiters (internal to the lexer)
                        ;&7C reserved                                      (")
&7D/*                   ;&7D Start of a multi-line comment
&7E*/                   ;&7D End of a multi-line comment
&7F//                   ;&7F Start of a single-line comment                (")
&7F#			;
                        ;&80..&FC (reserved)                               (")
                        ;&FD identifier
                        ;&FE integer constant

